# Copy to .env and fill in. These are the ONLY environment dependencies (RS-7).
# App under test
BASE_URL=http://localhost:3000
# SELECT-only DB role (DB-1). Create e.g.:
#   CREATE ROLE e2e_readonly LOGIN PASSWORD '...'; GRANT USAGE ON SCHEMA public TO e2e_readonly;
#   GRANT SELECT ON ALL TABLES IN SCHEMA public TO e2e_readonly;
DB_URL_RO=postgres://e2e_readonly:password@localhost:5432/app
# Contract-pinned external fakes (empty = no externals pinned yet)
FAKES_URL=
# Path to the app source root (canary harness creates throwaway git worktrees from it)
APP_REPO=../..
# Set to 1 to require the hermetic container phase in the determinism gate
E2E_HERMETIC=0
HERMETIC_IMAGE=mcr.microsoft.com/playwright:v1.48.0-jammy
